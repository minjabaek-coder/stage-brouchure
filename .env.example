# 로컬 PostgreSQL (Homebrew 설치 후, docs/06-tech-stack.md §7.3 참조)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eoullim_dev"

# E2E 테스트 전용 DB (playwright 가 사용)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/eoullim_test"

# Supabase Storage (이미지 자산 + CSV 백업)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE=""
SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_BUCKET="eoullim-assets"

# Upstash Redis (검색 Rate Limit, 1분 30회)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 관리자 경로 suffix (Security by Obscurity). 비우면 /admin
ADMIN_PATH_SUFFIX=""

# (선택) Sentry
SENTRY_DSN=""
