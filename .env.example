# ─── 로컬 개발 (Homebrew PostgreSQL, docs/06-tech-stack.md §7.3) ───
# Fresh install 가이드는 postgres:postgres 사용. 이미 brew 의 기본 superuser
# (현재 OS 계정) 가 있는 경우 그대로 사용 가능:
#   DATABASE_URL="postgresql://<your-os-user>@localhost:5432/eoullim_dev"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eoullim_dev"

# E2E 테스트 전용 DB (playwright 가 사용)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/eoullim_test"

# Prisma migrate / introspect 가 사용하는 direct connection. 로컬은 동일.
# Vercel/Supabase 환경에서는 DATABASE_URL 은 pooler(6543), DIRECT_URL 은
# direct(5432) 로 분리한다 (docs/09-deployment.md §4).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eoullim_dev"

# ─── 프로덕션 (Vercel + Supabase) ───
# Supabase Storage. 비우면 lib/storage.ts 가 로컬 public/uploads + .backups 로 폴백.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_IMAGES_BUCKET="images"
SUPABASE_BACKUPS_BUCKET="backups"

# Upstash Redis (검색 Rate Limit, 1분 30회). 비우면 in-memory fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 관리자 경로 suffix (Security by Obscurity). 비우면 /admin
ADMIN_PATH_SUFFIX=""

# 배포 도메인 (sitemap, OG image, metadataBase). 비우면 http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# (선택) Sentry
SENTRY_DSN=""
