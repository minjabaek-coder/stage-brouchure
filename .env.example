# ─── 로컬 개발 (Homebrew PostgreSQL, docs/06-tech-stack.md §7.3) ───
# Fresh install 가이드는 postgres:postgres 사용. 이미 brew 의 기본 superuser
# (현재 OS 계정) 가 있는 경우 그대로 사용 가능:
#   DATABASE_URL="postgresql://<your-os-user>@localhost:5432/eoullim_dev"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eoullim_dev"

# E2E 테스트 전용 DB (playwright 가 사용)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/eoullim_test"

# Prisma migrate / introspect 가 사용하는 unpooled connection. 로컬은 동일.
# Vercel/Neon 환경에서는 DATABASE_URL 은 pooler hostname(`-pooler`),
# DATABASE_URL_UNPOOLED 은 pooler 없는 hostname (docs/09-deployment.md §2).
# 변수명은 Vercel Marketplace Neon 통합이 주입하는 이름과 일치시켜 둔다.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/eoullim_dev"

# ─── 프로덕션 (Vercel + Neon + Vercel Blob) ───
# Neon: Vercel Marketplace 통합으로 DATABASE_URL, DIRECT_URL 자동 주입.
# 로컬에서 prod DB 를 향해 명령을 실행하려면:
#   vercel env pull .env.production.local
#   dotenv -e .env.production.local -- pnpm prisma migrate deploy
#
# Vercel Blob: 같은 방식으로 BLOB_READ_WRITE_TOKEN 자동 주입. 비우면
# src/lib/storage.ts 가 public/uploads + .backups 로컬 fs 로 폴백 (dev 편의).
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis (검색 Rate Limit, 1분 30회). 비우면 in-memory fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 관리자 경로 suffix (Security by Obscurity). 비우면 /admin
ADMIN_PATH_SUFFIX=""

# 배포 도메인 (sitemap, OG image, metadataBase). 비우면 http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# (선택) Sentry
SENTRY_DSN=""
