// Prisma schema — docs/04-data-model.md §3 그대로.
// 단일 행사(어울림콘서트 2026.5.26) 전제이므로 별도 Event 엔터티 없음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel 런타임은 Neon Pooler (hostname 에 `-pooler` 접미사) 를 통한다.
  // Migration / introspection 은 unpooled (direct) connection 이 필요해서 별도.
  // 로컬 dev/test 에서는 둘 다 같은 URL 이어도 무방.
  // 환경변수명은 Vercel Marketplace Neon 통합이 주입하는 이름을 그대로 사용:
  //   DATABASE_URL           — pooled (런타임)
  //   DATABASE_URL_UNPOOLED  — unpooled (마이그레이션)
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ENT-01 — CSV 업로드 시 truncate + insert 로 전체 교체된다 (PRD §3.3.4)
model Attendee {
  id         Int      @id @default(autoincrement())
  name       String
  phoneLast4 String   @map("phone_last4") @db.Char(4)
  seat       String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([name, phoneLast4])
  @@index([name])
  @@map("attendees")
}

// ENT-02 — seat_map / brochure_01..08 / video_youtube_id (key 는 enum 처럼 운용)
model Asset {
  key       String   @id
  url       String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("assets")
}

// ENT-03 (선택) — CSV 업로드 직전 데이터를 자동 백업, 최근 3개만 유지 (PRD §3.3.4)
model CsvBackup {
  id          Int      @id @default(autoincrement())
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  storagePath String   @map("storage_path")
  rowCount    Int?     @map("row_count")

  @@map("csv_backups")
}

// ENT-04 — 방명록 한마디. 닉네임 + 본문만 저장 (NFR-09). IP·이메일 미저장.
// 즉시 공개, 관리자가 /admin/messages 에서만 삭제 가능. Rate Limit 1/분/IP.
model Message {
  id        String   @id @default(cuid())
  nickname  String   @db.VarChar(10)
  body      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("messages")
}
